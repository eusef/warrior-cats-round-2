{
  "name": "warrior-cats-signal",
  "private": true,
  "version": "0.1.0",
  "description": "WebRTC signalling relay for Warrior Cats two-player co-op. Introduces two iPads, then gets out of the way.",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787 --local-protocol https --https-cert-path ../certs/lan-cert.pem --https-key-path ../certs/lan-key.pem",
    "dev:http": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
